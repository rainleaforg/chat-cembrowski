SERPAPI_KEY="Your SerpAPI key here"
QDRANT_API_KEY="Your Qdrant API key here"
QDRANT_CLUSTER_ENDPOINT="Your Qdrant cluster endpoint here"
VOYAGE_API_KEY="Your Voyage API key here"

# Only needed for scripts/backfill_kind.py, which reads the admin-upload
# documents table. Falls back to the sibling backend's .env if unset here.
DATABASE_URL="Your Postgres connection string here (optional)"

# The chat/answering models used by the retrieval path (src/chat_cembrowski/
# retrieval/). Default provider is OpenRouter running Gemini; see the README
# section "Which models the assistant uses, and why".
OPENROUTER_API_KEY="Your OpenRouter key here"

# Needed for now since we use OpenAI's client directly to access GPT during ingestion. Can switch to OpenRouter's client with a gpt model
OPENAI_API_KEY="Your OpenAI API key here"

# Optional. All have working defaults.
#   LLM_PROVIDER          "openrouter" (default) or "openai". Setting this to
#                         "openai" is the one-line rollback to GPT-4.1.
#   CHAT_MODEL            Empty (default): selects the provider's default chat model.
#                         Override to use a specific model for answer synthesis.
#   CLASSIFIER_MODEL      Empty (default): selects the provider's default classifier model.
#                         Override to use a specific model for classification and condensing.
#   LLM_REASONING_EFFORT  Thinking budget for synthesis. Accepted values:
#                         "none", "minimal" (default), "low", "medium", "high", "xhigh".
#                         The classifier is pinned to "minimal" and ignores this setting.
LLM_PROVIDER="openrouter"
CHAT_MODEL=""
CLASSIFIER_MODEL=""
LLM_REASONING_EFFORT="minimal"

# Optional. Used for NIH lookups (PubMed via NCBI E-utilities) when answering
# general medical questions. Not required — MedlinePlus and PubMed both work
# without them — but an API key raises the free rate limit from 3 to 10
# requests/sec, and an email is standard NCBI etiquette for identifying your
# tool. See https://support.nlm.nih.gov/kbArticle/?pn=KA-05317
NCBI_API_KEY="Your NCBI API key here (optional)"
NCBI_EMAIL="Your contact email here (optional)"